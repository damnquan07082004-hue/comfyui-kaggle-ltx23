    "# ============================================================\n",
    "# 2. DOWNLOAD MODELS (Unsloth GGUF + Lightricks IC-LoRA)\n",
    "# ============================================================\n",
    "import requests, subprocess, shutil, time\n",
    "from pathlib import Path\n",
    "\n",
    "HF = \"https://huggingface.co\"\n",
    "models_dir = Path(\"/kaggle/working/ComfyUI/models\")\n",
    "\n",
    "MODEL_MAP = {\n",
    "    \"Q2_K\": f\"{HF}/unsloth/LTX-2.3-GGUF/resolve/main/ltx-2.3-22b-dev-Q2_K.gguf\",\n",
    "    \"Q3_K_M\": f\"{HF}/unsloth/LTX-2.3-GGUF/resolve/main/ltx-2.3-22b-dev-Q3_K_M.gguf\",\n",
    "    \"Q4_K_M\": f\"{HF}/unsloth/LTX-2.3-GGUF/resolve/main/ltx-2.3-22b-dev-Q4_K_M.gguf\",\n",
    "}\n",
    "\n",
    "def download(url, dest, label=\"\", retries=2):\n",
    "    dest = Path(dest)\n",
    "    if dest.exists() and dest.stat().st_size > 1_000_000:\n",
    "        gb = dest.stat().st_size / 1e9\n",
    "        print(f\"  \u2705 {label} ({gb:.1f} GB)\")\n",
    "        return True\n",
    "    \n",
    "    dest.parent.mkdir(parents=True, exist_ok=True)\n",
    "    print(f\"  \u2b07\ufe0f  {label}...\", end=\" \", flush=True)\n",
    "    \n",
    "    for attempt in range(retries + 1):\n",
    "        try:\n",
    "            if shutil.which(\"aria2c\"):\n",
    "                r = subprocess.run([\n",
    "                    \"aria2c\", \"--console-log-level=error\", \"-c\",\n",
    "                    \"-x\", \"16\", \"-s\", \"16\", \"-k\", \"1M\",\n",
    "                    url, \"-d\", str(dest.parent), \"-o\", dest.name\n",
    "                ], capture_output=True, timeout=600)\n",
    "                if r.returncode != 0:\n",
    "                    raise Exception(r.stderr.decode()[:200])\n",
    "            else:\n",
    "                r = requests.get(url, stream=True, timeout=60)\n",
    "                r.raise_for_status()\n",
    "                total = int(r.headers.get('content-length', 0))\n",
    "                with open(dest, 'wb') as f:\n",
    "                    downloaded = 0\n",
    "                    for chunk in r.iter_content(8*1024*1024):\n",
    "                        if chunk:\n",
    "                            f.write(chunk)\n",
    "                            downloaded += len(chunk)\n",
    "                            if total:\n",
    "                                pct = downloaded/total*100\n",
    "                                print(f\"\\r  \u2b07\ufe0f  {label}: {pct:.0f}% ({downloaded/1e9:.1f}/{total/1e9:.1f} GB)\", end=\"\", flush=True)\n",
    "            gb = dest.stat().st_size / 1e9\n",
    "            print(f\"\\r  \u2705 {label} ({gb:.1f} GB)   \")\n",
    "            return True\n",
    "        except Exception as e:\n",
    "            if attempt < retries:\n",
    "                print(f\"\\n  \u26a0\ufe0f Retry {attempt+1}/{retries}: {e}\")\n",
    "                continue\n",
    "            print(f\"\\n  \u274c Failed: {e}\")\n",
    "            return False\n",
    "\n",
    "if not DOWNLOAD_MODELS:\n",
    "    print(\"\u23ed\ufe0f Skip model download\")\n",
    "else:\n",
    "    t0 = time.time()\n",
    "    model_url = MODEL_MAP.get(MODEL_VARIANT, MODEL_MAP[\"Q3_K_M\"])\n",
    "    \n",
    "    print(f\"\\n\ud83d\udce6 Models (variant: {MODEL_VARIANT})\\n\")\n",
    "    \n",
    "    # 2.1 Main GGUF \u2192 unet/\n",
    "    download(model_url,\n",
    "        models_dir / \"unet\" / f\"ltx-2.3-22b-dev-{MODEL_VARIANT}.gguf\",\n",
    "        f\"LTX-2.3 GGUF {MODEL_VARIANT}\")\n",
    "    \n",
    "    # 2.2 Video VAE\n",
    "    download(\n",
    "        f\"{HF}/unsloth/LTX-2.3-GGUF/resolve/main/vae/ltx-2.3-22b-dev_video_vae.safetensors\",\n",
    "        models_dir / \"vae\" / \"ltx-2.3-22b-dev_video_vae.safetensors\", \"Video VAE\")\n",
    "    \n",
    "    # 2.3 Audio VAE (optional)\n",
    "    if INCLUDE_AUDIO:\n",
    "        download(\n",
    "            f\"{HF}/unsloth/LTX-2.3-GGUF/resolve/main/vae/ltx-2.3-22b-dev_audio_vae.safetensors\",\n",
    "            models_dir / \"vae\" / \"ltx-2.3-22b-dev_audio_vae.safetensors\", \"Audio VAE\")\n",
    "    \n",
    "    # 2.4 Text Encoder connectors\n",
    "    download(\n",
    "        f\"{HF}/unsloth/LTX-2.3-GGUF/resolve/main/text_encoders/ltx-2.3-22b-dev_embeddings_connectors.safetensors\",\n",
    "        models_dir / \"text_encoders\" / \"ltx-2.3-22b-dev_embeddings_connectors.safetensors\",\n",
    "        \"Embeddings Connectors\")\n",
    "    \n",
    "    # 2.5 Gemma 3 Text Encoder (GGUF quantized)\n",
    "    download(\n",
    "        f\"{HF}/unsloth/gemma-3-12b-it-qat-GGUF/resolve/main/gemma-3-12b-it-qat-UD-Q4_K_XL.gguf\",\n",
    "        models_dir / \"text_encoders\" / \"gemma-3-12b-it-qat-UD-Q4_K_XL.gguf\",\n",
    "        \"Gemma 3 12B Text Encoder\")\n",
    "    download(\n",
    "        f\"{HF}/unsloth/gemma-3-12b-it-qat-GGUF/resolve/main/mmproj-BF16.gguf\",\n",
    "        models_dir / \"text_encoders\" / \"mmproj-BF16.gguf\", \"Gemma mmproj\")\n",
    "    \n",
    "    # 2.6 Distilled LoRA\n",
    "    download(\n",
    "        f\"{HF}/Lightricks/LTX-2.3/resolve/main/ltx-2.3-22b-distilled-lora-384.safetensors\",\n",
    "        models_dir / \"loras\" / \"ltx-2.3-22b-distilled-lora-384.safetensors\", \"Distilled LoRA\")\n",
    "    \n",
    "    # 2.7 IC-LoRA Union Control (gi\u1eef m\u1eb7t + multi-reference)\n",
    "    if INCLUDE_ICLORA:\n",
    "        download(\n",
    "            f\"{HF}/Lightricks/LTX-2.3/resolve/main/ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors\",\n",
    "            models_dir / \"loras\" / \"ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors\",\n",
    "            \"IC-LoRA Union Control\")\n",
    "    \n",
    "    # 2.8 Latent Upscaler\n",
    "    download(\n",
    "        f\"{HF}/Lightricks/LTX-2.3/resolve/main/ltx-2.3-spatial-upscaler-x2-1.0.safetensors\",\n",
    "        models_dir / \"latent_upscale_models\" / \"ltx-2.3-spatial-upscaler-x2-1.0.safetensors\",\n",
    "        \"Spatial Upscaler\")\n",
    "    \n",
    "    total_gb = sum(f.stat().st_size for f in models_dir.rglob(\"*\") if f.is_file()) / 1e9\n",
    "    elapsed = time.time() - t0\n",
    "    print(f\"\\n\ud83d\udcca T\u1ed5ng: {total_gb:.1f} GB models ({elapsed/60:.0f} ph\u00fat)\")\n"
   ]
  },

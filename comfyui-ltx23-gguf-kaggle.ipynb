   # ============================================================
   # 4. START COMFYUI + TUNNEL 🚀
   # ============================================================
   import urllib.request, subprocess, sys, json, os, time
   from pathlib import Path

   WORKING = Path("/kaggle/working")
   VENV_DIR = WORKING / "venv"
   COMFY_DIR = WORKING / "ComfyUI"

   # 4.1 GPU info
   r = subprocess.run(["nvidia-smi", "--query-gpu=name,memory.total,index", "--format=csv,noheader"],
       capture_output=True, text=True, timeout=10)
   print(f"🔍 GPU:\n{r.stdout}")

   # 4.2 Build ComfyUI command
   python_bin = str(VENV_DIR / "bin" / "python")
   comfy_args = [python_bin, str(COMFY_DIR / "main.py"),
       "--listen", "127.0.0.1", "--port", "8188"]
   if LOW_VRAM_MODE:
       comfy_args.append("--highvram")
   comfy_cmd = ' '.join(comfy_args)

   # 4.3 Start ComfyUI in background
   comfy_proc = subprocess.Popen(comfy_args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
   print("🚀 ComfyUI started (background)")

   # 4.4 Chờ ComfyUI sẵn sàng
   for i in range(30):
       time.sleep(2)
       try:
           r = urllib.request.urlopen("http://127.0.0.1:8188/system/stats", timeout=3)
           print(f"✅ ComfyUI ready! ({i*2}s)")
           break
       except:
           if i == 29:
               print("⚠️  Timeout chờ ComfyUI, nhưng vẫn start tunnel...")
           continue

   # ============================================================
   # TUNNEL MODE
   # ============================================================
   if TUNNEL_MODE == "cloudflare":
       # === CLOUDFLARE TUNNEL — URL CỐ ĐỊNH ===
       print("\n☁️  Cloudflare Tunnel — URL cố định, không đổi!\n")
    
       # Cài cloudflared
       cf_path = WORKING / "cloudflared"
       if not cf_path.exists():
           print("⬇️  Downloading cloudflared...")
           urllib.request.urlretrieve(
               "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64",
               cf_path)
           os.chmod(cf_path, 0o755)
           print("✅ cloudflared installed")
    
       # Chọn phương thức auth
       if CF_TUNNEL_TOKEN:
           # === CÁCH 1: Token-based (dễ nhất) ===
           # 1. Vào https://dash.cloudflare.com/profile/api-tokens
           # 2. "Create Token" → "Edit Cloudflare Workers" template
           # 3. Thêm quyền: Cloudflare Tunnel -> Edit
           # 4. Copy token dán vào CF_TUNNEL_TOKEN
           print(f"☁️  Tunnel: {CF_DOMAIN}")
           subprocess.run([
               str(cf_path), "tunnel", "--no-autoupdate", "run",
               "--token", CF_TUNNEL_TOKEN,
               "--url", "http://localhost:8188"
           ], check=False)
       else:
           # === CÁCH 2: Credentials file (lưu giữa các session) ===
           cred_path = Path(CF_CREDENTIALS_PATH)
           if cred_path.exists():
               print(f"☁️  Tunnel: {CF_DOMAIN}")
               subprocess.run([
                   str(cf_path), "tunnel", "--no-autoupdate", "run",
                   "--cred-file", str(cred_path),
                   CF_TUNNEL_NAME
               ], check=False)
           else:
               print("⚠️  Không tìm thấy credentials file!")
               print("\n📋 HƯỚNG DẪN SETUP LẦN ĐẦU:")
               print("  1. Cài cloudflared local: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/")
               print("  2. Chạy: cloudflared tunnel create comfyui-ltx23")
               print("  3. Chạy: cloudflared tunnel route dns comfyui-ltx23 {CF_DOMAIN}")
               print("  4. Upload file ~/.cloudflared/*.json lên Kaggle Dataset")
               print("  5. Set CF_CREDENTIALS_PATH = đường dẫn file đó")
               print("\n⏩ Fallback sang Pinggy...")
               TUNNEL_MODE = "pinggy"

   if TUNNEL_MODE == "pinggy":
       # === PINGGY TUNNEL — NHANH, KHÔNG CẦN SETUP ===
       print("\n🔗 Pinggy Tunnel — URL đổi mỗi giờ")
    
       pinggy = WORKING / "pinggy.py"
       if not pinggy.exists():
           print("⬇️  Pinggy tunnel script...")
           urllib.request.urlretrieve(
               "https://raw.githubusercontent.com/wandaweb/jupyter-webui-tunneling/main/pinggy.py",
               pinggy)
    
       sys.executable = python_bin
       !python /kaggle/working/pinggy.py --command='{comfy_cmd}' --port=8188
   ]

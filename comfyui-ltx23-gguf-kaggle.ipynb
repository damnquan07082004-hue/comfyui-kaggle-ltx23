   "source": [
    "# ============================================================\n",
    "# \u2699\ufe0f C\u1ea4U H\u00ccNH\n",
    "# ============================================================\n",
    "\n",
    "# --- Model variant ---\n",
        "# Q2_K (7.94 GB) — P100 16GB thoải mái, chất lượng thấp\n",
        "# Q3_K_M (~10.6 GB) — P100 16GB vừa đủ, KHUYÊN DÙNG\n",
        "# Q4_K_M (~14.2 GB) — Chỉ T4 2x (split GPU), chất lượng cao\n",
        "MODEL_VARIANT = \"Q3_K_M\"\n",
        "\n",
        "# --- Tự động download ---\n",
        "DOWNLOAD_MODELS = True\n",
        "DOWNLOAD_WORKFLOWS = True\n",
        "\n",
        "# --- Audio support ---\n",
        "INCLUDE_AUDIO = True\n",
        "\n",
        "# --- Include IC-LoRA (giữ mặt nhân vật) ---\n",
        "INCLUDE_ICLORA = True\n",
        "\n",
        "# --- Low VRAM mode (offload layers to CPU) ---\n",
        "LOW_VRAM_MODE = True\n",
        "\n",
        "# --- TUNNEL ---\n",
        "# \"pinggy\" — Nhanh, không cần cấu hình, URL đổi mỗi giờ\n",
        "# \"cloudflare\" — URL cố định, cần domain + Cloudflare account\n",
        "TUNNEL_MODE = \"pinggy\"\n",
        "\n",
        "# --- Cloudflare Tunnel config (chỉ dùng khi TUNNEL_MODE=\"cloudflare\") ---\n",
        "# Lấy từ: https://dash.cloudflare.com/profile/api-tokens → Create token\n",
        "# Cần quyền: Cloudflare Tunnel + DNS:Edit\n",
       "CF_TUNNEL_TOKEN = \"\"  # Cloudflare API token\n",
        "# Hoặc dùng credentials file (lưu trên Kaggle Dataset / Google Drive)\n",
        "CF_CREDENTIALS_PATH = \"/kaggle/working/cloudflare/credentials.json\"\n",
        "CF_TUNNEL_NAME = \"comfyui-ltx23\"\n",
        "CF_DOMAIN = \"comfyui.yourdomain.com\"  # Thay = domain thật của anh\n",
        "\n",
        "print(f\"✅ Cấu hình: {MODEL_VARIANT} | Audio={INCLUDE_AUDIO} | ICLoRA={INCLUDE_ICLORA} | LowVRAM={LOW_VRAM_MODE}\")\n",
        "print(f\"   Tunnel: {TUNNEL_MODE}\")"
   ]
  },
  {
   "cell_type": "code",

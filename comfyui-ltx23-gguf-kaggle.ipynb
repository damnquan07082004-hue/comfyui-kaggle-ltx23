   "source": [
    "# ============================================================\n",
    "# 1. C\u00c0I \u0110\u1eb6T M\u00d4I TR\u01af\u1edcNG + COMFYUI\n",
    "# ============================================================\n",
    "import os, sys, subprocess, shutil, time\n",
    "from pathlib import Path\n",
    "\n",
    "WORKING = Path(\"/kaggle/working\")\n",
    "COMFY_DIR = WORKING / \"ComfyUI\"\n",
    "VENV_DIR = WORKING / \"venv\"\n",
    "MODELS_DIR = COMFY_DIR / \"models\"\n",
    "CUSTOM_NODES = COMFY_DIR / \"custom_nodes\"\n",
    "\n",
    "start = time.time()\n",
    "print(\"\ud83d\udd27 C\u00e0i \u0111\u1eb7t m\u00f4i tr\u01b0\u1eddng...\\n\")\n",
    "\n",
    "# 1.1 Create venv\n",
    "if not VENV_DIR.exists():\n",
    "    subprocess.run([sys.executable, \"-m\", \"venv\", str(VENV_DIR)], check=True)\n",
    "    print(\"\u2705 Virtual env created\")\n",
    "\n",
    "python_bin = str(VENV_DIR / \"bin\" / \"python\")\n",
    "pip_install = [python_bin, \"-m\", \"pip\", \"install\", \"-q\"]\n",
    "\n",
    "# 1.2 Install PyTorch\n",
    "subprocess.run([*pip_install, \"torch\", \"torchvision\", \"torchaudio\",\n",
    "    \"--index-url\", \"https://download.pytorch.org/whl/cu124\"], check=True)\n",
    "print(\"\u2705 PyTorch CUDA 12.4\")\n",
    "\n",
    "# 1.3 Core deps\n",
    "subprocess.run([*pip_install,\n",
    "    \"huggingface-hub\", \"requests\", \"aria2p\",\n",
    "    \"einops\", \"diffusers\", \"accelerate\", \"av\", \"spandrel\",\n",
    "    \"albumentations\", \"opencv-python\", \"onnx\", \"onnxruntime\",\n",
    "    \"torchsde\", \"decord\"], check=True)\n",
    "print(\"\u2705 Dependencies\")\n",
    "\n",
    "# 1.4 Clone ComfyUI (branch LTX 2.3 compatible)\n",
    "if not COMFY_DIR.exists():\n",
    "    subprocess.run([\"git\", \"clone\", \"--branch\", \"ComfyUI_ltx_2_3_compliant_19_03_2026\",\n",
    "        \"https://github.com/Isi-dev/ComfyUI\", str(COMFY_DIR)], check=True)\n",
    "    subprocess.run([*pip_install, \"-r\", str(COMFY_DIR / \"requirements.txt\")], check=True)\n",
    "    print(\"\u2705 ComfyUI\")\n",
    "\n",
    "# 1.5 Clone custom nodes\n",
    "os.chdir(str(CUSTOM_NODES))\n",
    "\n",
    "NODES = {\n",
    "    \"ComfyUI-Manager\": \"https://github.com/Comfy-Org/ComfyUI-Manager\",\n",
    "    \"ComfyUI-GGUF\": \"https://github.com/city96/ComfyUI-GGUF\",\n",
    "    \"ComfyUI-LTXVideo\": \"https://github.com/Lightricks/ComfyUI-LTXVideo\",\n",
    "    \"ComfyUI_KJNodes\": \"https://github.com/kijai/ComfyUI-KJNodes\",\n",
    "    \"rgthree-comfy\": \"https://github.com/rgthree/rgthree-comfy.git\",\n",
    "    \"ComfyUI-VideoHelperSuite\": \"https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite\",\n",
    "    \"ComfyUI-Easy-Use\": \"https://github.com/yolain/ComfyUI-Easy-Use\",\n",
    "    \"ComfyUI_essentials\": \"https://github.com/cubiq/ComfyUI_essentials\",\n",
    "    \"ComfyUI-Custom-Scripts\": \"https://github.com/pythongosssss/ComfyUI-Custom-Scripts\",\n",
    "}\n",
    "\n",
    "for name, url in NODES.items():\n",
    "    node_path = CUSTOM_NODES / name\n",
    "    if not node_path.exists():\n",
    "        subprocess.run([\"git\", \"clone\", url, str(node_path)],\n",
    "            capture_output=True, check=False)\n",
    "        req = node_path / \"requirements.txt\"\n",
    "        if req.exists():\n",
    "            subprocess.run([*pip_install, \"-r\", str(req)], capture_output=True, check=False)\n",
    "        print(f\"  \u2705 {name}\")\n",
    "    else:\n",
    "        print(f\"  \u2705 {name} (exists)\")\n",
    "\n",
    "# 1.6 Create model subdirs\n",
    "for sd in [\"unet\", \"vae\", \"text_encoders\", \"loras\", \"latent_upscale_models\", \"clip_vision\"]:\n",
    "    (MODELS_DIR / sd).mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "elapsed = time.time() - start\n",
    "print(f\"\\n\u2705 Environment ready! ({elapsed:.0f}s)\")\n"
   ]
  },

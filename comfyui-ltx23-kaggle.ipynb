   "source": [
    "# ComfyUI + LTX 2.3 GGUF on Kaggle\n",
    "**Model:** Unsloth LTX-2.3-GGUF Q3_K_M\n",
    "**Workflows:** T2V, I2V, V2V, ICLoRA, Motion Track\n",
    "---\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- CONFIG ---\n",
    "MODEL_VARIANT = \"Q3_K_M\"\n",
    "DOWNLOAD_MODELS = True\n",
    "DOWNLOAD_WORKFLOWS = True\n",
    "INCLUDE_AUDIO = True\n",
    "INCLUDE_ICLORA = True\n",
    "LOW_VRAM_MODE = True\n",
    "TUNNEL_MODE = \"pinggy\"\n",
    "print(f\"Config: {MODEL_VARIANT}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, sys, subprocess, shutil, time\n",
    "from pathlib import Path\n",
    "\n",
    "WORKING = Path(\"/kaggle/working\")\n",
    "COMFY = WORKING / \"ComfyUI\"\n",
    "VENV = WORKING / \"venv\"\n",
    "start = time.time()\n",
    "print(\"Installing env...\")\n",
    "\n",
    "# FIX: virtualenv thay vi venv (Python 3.12)\n",
    "if not VENV.exists():\n",
    "    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"virtualenv\"], check=True)\n",
    "    subprocess.run([\"virtualenv\", str(VENV), \"-p\", \"/usr/bin/python3.10\"], check=True)\n",
    "\n",
    "PY = str(VENV / \"bin\" / \"python3.10\")\n",
    "PIP = [PY, \"-m\", \"pip\", \"install\", \"-q\"]\n",
    "\n",
    "subprocess.run([*PIP, \"torch\",\"torchvision\",\"torchaudio\", \"--index-url\", \"https://download.pytorch.org/whl/cu124\"], check=True)\n",
    "print(\"PyTorch OK\")\n",
    "subprocess.run([*PIP, \"requests\",\"einops\",\"diffusers\",\"accelerate\",\"av\",\"opencv-python\"], check=True)\n",
    "print(\"Deps OK\")\n",
    "\n",
    "if not COMFY.exists():\n",
    "    subprocess.run([\"git\",\"clone\",\"--branch\",\"ComfyUI_ltx_2_3_compliant_19_03_2026\",\n",
    "        \"https://github.com/Isi-dev/ComfyUI\",str(COMFY)], check=True)\n",
    "    subprocess.run([*PIP, \"-r\", str(COMFY / \"requirements.txt\")], check=True)\n",
    "print(\"ComfyUI OK\")\n",
    "\n",
    "# Custom nodes\n",
    "os.chdir(str(COMFY / \"custom_nodes\"))\n",
    "for n,u in {\n",
    "    \"ComfyUI-Manager\":\"https://github.com/Comfy-Org/ComfyUI-Manager\",\n",
    "    \"ComfyUI-GGUF\":\"https://github.com/city96/ComfyUI-GGUF\",\n",
    "    \"ComfyUI-LTXVideo\":\"https://github.com/Lightricks/ComfyUI-LTXVideo\",\n",
    "    \"ComfyUI_KJNodes\":\"https://github.com/kijai/ComfyUI-KJNodes\",\n",
    "    \"rgthree-comfy\":\"https://github.com/rgthree/rgthree-comfy.git\",\n",
    "    \"ComfyUI-VideoHelperSuite\":\"https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite\"\n",
    "}.items():\n",
    "    p = COMFY / \"custom_nodes\" / n\n",
    "    if not p.exists():\n",
    "        subprocess.run([\"git\",\"clone\",u,str(p)],capture_output=True,check=False)\n",
    "        req = p / \"requirements.txt\"\n",
    "        if req.exists(): subprocess.run([*PIP,\"-r\",str(req)],capture_output=True,check=False)\n",
    "\n",
    for sd in [\"unet\",\"vae\",\"text_encoders\",\"loras\"]:
        (COMFY / \"models\" / sd).mkdir(parents=True,exist_ok=True)

    # FIX: Symlink models to /tmp to avoid /kaggle/working (20GB limit)
    print(\"Check disk space:\")
    subprocess.run([\"df\",\"-h\",\"/kaggle/working\",\"/tmp\",\"/kaggle/tmp\"])
    for d in [\"unet\",\"vae\",\"text_encoders\",\"loras\",\"latent_upscale_models\"]:
        src = COMFY / \"models\" / d
        dst = Path(f\"/tmp/models/{d}\")
        dst.mkdir(parents=True, exist_ok=True)
        if src.is_dir():
            shutil.rmtree(src)
        elif src.is_symlink():
            src.unlink()
        src.symlink_to(dst)
    print(\"Models redirected to /tmp/\")
    "print(f\"Done ({time.time()-start:.0f}s)\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests, urllib.request, time\n",
    "from pathlib import Path\n",
    "\n",
    "HF = \"https://huggingface.co\"\n",
    "MDIR = COMFY / \"models\"\n",
    "\n",
    "URLS = {\n",
    "    \"Model\": f\"{HF}/unsloth/LTX-2.3-GGUF/resolve/main/ltx-2.3-22b-dev-{MODEL_VARIANT}.gguf\",\n",
    "    \"VAE\": f\"{HF}/unsloth/LTX-2.3-GGUF/resolve/main/vae/ltx-2.3-22b-dev_video_vae.safetensors\",\n",
    "    \"Embeddings\": f\"{HF}/unsloth/LTX-2.3-GGUF/resolve/main/text_encoders/ltx-2.3-22b-dev_embeddings_connectors.safetensors\",\n",
    "    \"Gemma\": f\"{HF}/unsloth/gemma-3-12b-it-qat-GGUF/resolve/main/gemma-3-12b-it-qat-UD-Q4_K_XL.gguf\",\n",
    "    \"mmproj\": f\"{HF}/unsloth/gemma-3-12b-it-qat-GGUF/resolve/main/mmproj-BF16.gguf\",\n",
    "    \"LoRA\": f\"{HF}/Lightricks/LTX-2.3/resolve/main/ltx-2.3-22b-distilled-lora-384.safetensors\",\n",
    "}\n",
    "if INCLUDE_ICLORA:\n",
    "    URLS[\"IC-LoRA\"] = f\"{HF}/Lightricks/LTX-2.3/resolve/main/ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors\"\n",
    "URLS[\"Upscaler\"] = f\"{HF}/Lightricks/LTX-2.3/resolve/main/ltx-2.3-spatial-upscaler-x2-1.0.safetensors\"\n",
    "\n",
    "DEST = {\n",
    "    \"Model\": MDIR / \"unet\" / f\"ltx-2.3-22b-dev-{MODEL_VARIANT}.gguf\",\n",
    "    \"VAE\": MDIR / \"vae\" / \"ltx-2.3-22b-dev_video_vae.safetensors\",\n",
    "    \"Embeddings\": MDIR / \"text_encoders\" / \"ltx-2.3-22b-dev_embeddings_connectors.safetensors\",\n",
    "    \"Gemma\": MDIR / \"text_encoders\" / \"gemma-3-12b-it-qat-UD-Q4_K_XL.gguf\",\n",
    "    \"mmproj\": MDIR / \"text_encoders\" / \"mmproj-BF16.gguf\",\n",
    "    \"LoRA\": MDIR / \"loras\" / \"ltx-2.3-22b-distilled-lora-384.safetensors\",\n",
    "    \"IC-LoRA\": MDIR / \"loras\" / \"ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors\",\n",
    "    \"Upscaler\": MDIR / \"latent_upscale_models\" / \"ltx-2.3-spatial-upscaler-x2-1.0.safetensors\",\n",
    "}\n",
    "\n",
    "if DOWNLOAD_MODELS:\n",
    "    t0 = time.time()\n",
    "    for name, url in URLS.items():\n",
    "        dest = DEST[name]\n",
    "        if dest.exists() and dest.stat().st_size > 1_000_000:\n",
    "            print(f\"  OK {name} ({dest.stat().st_size/1e9:.1f} GB)\")\n",
    "            continue\n",
    "        dest.parent.mkdir(parents=True, exist_ok=True)\n",
    "        print(f\"  DL {name}...\")\n",
    "        urllib.request.urlretrieve(url, dest)\n",
    "        print(f\"    {dest.stat().st_size/1e9:.1f} GB\")\n",
    "    total = sum(f.stat().st_size for f in MDIR.rglob(\"*\") if f.is_file())/1e9\n",
    "    print(f\"Total: {total:.1f} GB ({time.time()-t0:.0f}s)\")"
   ]
  },

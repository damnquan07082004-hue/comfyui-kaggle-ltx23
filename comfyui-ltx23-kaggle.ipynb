 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🚀 ComfyUI + LTX 2.3 GGUF — Multi-Account Video Generator\n",
    "**Dựa trên:** pogscafe/comfyui-kaggle-march-2025 (⭐2202) + Lightricks/ComfyUI-LTXVideo (⭐3.9k)\n",
    "**Cơ chế:** Notebook start → ComfyUI → Tunnel Pinggy → Ghi URL lên GitHub Gist → Hermes tự dispatch\n",
    "---\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ===== CONFIG =====\n",
    "BACKEND_NAME = \"kaggle-a\"\n",
    "GIST_ID = \"8da27f2e6e0d8809a043712cd90f9237\"\n",
    "print(f\"Backend: {BACKEND_NAME}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 1. Cài môi trường"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%%time\n",
    "import os, sys, subprocess, threading, time, requests, json\n",
    "from datetime import datetime\n",
    "\n",
    "home = '/kaggle/working'\n",
    "COMFY = f'{home}/ComfyUI'\n",
    "os.chdir(home)\n",
    "\n",
    "# Fix: Dùng pip3 tr?c ti?p, không t?o venv (Kaggle Python 3.12)\n",
    pip = 'pip'\n",
    "python = 'python3'\n",
    "print('OK')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%%time\n",
    "# Clone ComfyUI\n",
    "if not os.path.exists(COMFY):\n",
    "    !git clone https://github.com/comfyanonymous/ComfyUI.git\n",
    "    os.chdir(COMFY)\n",
    "else:\n",
    "    os.chdir(COMFY)\n",
    "    !git pull\n",
    "!{pip} install -r requirements.txt\n",
    "print('ComfyUI ready')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%%time\n",
    "# Clone custom nodes\n",
    "os.chdir(f'{COMFY}/custom_nodes')\n",
    "for url, name in [\n",
    "    ('https://github.com/Lightricks/ComfyUI-LTXVideo.git', 'ComfyUI-LTXVideo'),\n",
    "    ('https://github.com/logtd/ComfyUI-LTXTricks.git', 'ComfyUI-LTXTricks'),\n",
    "    ('https://github.com/city96/ComfyUI-GGUF.git', 'ComfyUI-GGUF'),\n",
    "]:\n",
    "    if not os.path.exists(name):\n",
    "        !git clone {url}\n",
    "        print(f'  {name} OK')\n",
    "print('All custom nodes installed')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 2. Download Models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%%time\n",
    "# Download LTX-2.3 GGUF Q2_K (12.4 GB)\n",
    "model_dir = f'{COMFY}/models/unet'\n",
    "os.makedirs(model_dir, exist_ok=True)\n",
    "os.chdir(model_dir)\n",
    "\n",
    "url = 'https://huggingface.co/QuantStack/LTX-2.3-GGUF/resolve/main/LTX-2.3-distilled-1.1/LTX-2.3-22B-distilled-1.1-Q2_K.gguf'\n",
    "file = 'LTX-2.3-22B-distilled-1.1-Q2_K.gguf'\n",
    "\n",
    "if not os.path.exists(file):\n",
    "    print('Downloading 12.4 GB...')\n",
    "    !wget -c \"{url}\" -O \"{file}\" 2>&1\n",
    "    sz = os.path.getsize(file)/1e9\n",
    "    print(f'Downloaded: {sz:.1f} GB')\n",
    "else:\n",
    "    print(f'Already exists: {os.path.getsize(file)/1e9:.1f} GB')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%%time\n",
    "# Download text encoder + VAE\n",
    "for dir, path, url_part in [\n",
    "    (f'{COMFY}/models/clip', 'gemma-2b.safetensors', 'text_encoder/model.safetensors'),\n",
    "    (f'{COMFY}/models/vae', 'ltx-vae.safetensors', 'vae/vae.safetensors'),\n",
    "]:\n",
    "    os.makedirs(dir, exist_ok=True)\n",
    "    dest = f'{dir}/{path}'\n",
    "    if not os.path.exists(dest):\n",
    "        !wget -c \"https://huggingface.co/Lightricks/LTX-2/resolve/main/{url_part}\" -O \"{dest}\" 2>&1\n",
    "print('Text encoder + VAE ready')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 3. Start ComfyUI + Tunnel Pinggy"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Start ComfyUI headless\n",
    "os.chdir(COMFY)\n",
    "# Kill any old ComfyUI\n",
    "!pkill -f main.py 2>/dev/null\n",
    "time.sleep(2)\n",
    "\n",
    "proc = subprocess.Popen(\n",
    "    [python, 'main.py', '--headless', '--port', '8188', '--listen', '127.0.0.1',\n",
    "     '--dont-print-server', '--highvram'],\n",
    "    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL\n",
    ")\n",
    "\n",
    "# Wait for ready\n",
    "for i in range(30):\n",
    "    time.sleep(3)\n",
    "    try:\n",
    "        r = requests.get('http://127.0.0.1:8188/object_info', timeout=2)\n",
    "        if r.status_code == 200:\n",
    "            print(f'ComfyUI ready! PID: {proc.pid}')\n",
    "            break\n",
    "    except:\n",
    "        pass\n",
    "else:\n",
    "    print('ComfyUI failed, check logs')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Tunnel Pinggy\n",
    "TUNNEL_URL = None\n",
    "\n",
    "def pinggy_thread():\n",
    "    global TUNNEL_URL\n",
    "    cmd = 'ssh -p 443 -R0:localhost:8188 a.pinggy.io'\n",
    "    p = subprocess.Popen(cmd.split(), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)\n",
    "    for line in p.stdout:\n",
    "        if 'https://' in line:\n",
    "            idx = line.find('https://')\n",
    "            TUNNEL_URL = line[idx:].strip().split()[0]\n",
    "            with open(f'{home}/tunnel_url.txt', 'w') as f:\n",
    "                f.write(TUNNEL_URL)\n",
    "            print(f'URL: {TUNNEL_URL}')\n",
    "            break\n",
    "\n",
    "t = threading.Thread(target=pinggy_thread, daemon=True)\n",
    "t.start()\n",
    "\n",
    "# Wait for URL\n",
    "for i in range(30):\n",
    "    if TUNNEL_URL:\n",
    "        break\n",
    "    try:\n",
    "        with open(f'{home}/tunnel_url.txt') as f:\n",
    "            TUNNEL_URL = f.read().strip()\n",
    "    except:\n",
    "        pass\n",
    "    time.sleep(5)\n",
    "\n",
    "if TUNNEL_URL:\n",
    "    print(f'Tunnel: {TUNNEL_URL}')\n",
    "else:\n",
    "    print('No tunnel URL yet')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 4. Push URL lên GitHub Gist"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def update_gist(url, status):\n",
    "    data = {}\n",
    "    try:\n",
    "        r = requests.get(f'https://api.github.com/gists/{GIST_ID}', timeout=5)\n",
    "        if r.status_code == 200:\n",
    "            c = r.json()['files']['kaggle_backends.json']['content']\n",
    "            data = json.loads(c) if c.strip() else {}\n",
    "    except:\n",
    "        pass\n",
    "    data[BACKEND_NAME] = {\n",
    "        'url': url, 'status': status,\n",
    "        'updated': datetime.now().isoformat(),\n",
    "        'capabilities': ['t2v', 'i2v', 'v2v', 'motion_control'],\n",
    "        'gpu': 't4',\n",
    "    }\n",
    "    r = requests.patch(f'https://api.github.com/gists/{GIST_ID}',\n",
    "        json={'files': {'kaggle_backends.json': {'content': json.dumps(data, indent=2)}}},\n",
    "        timeout=10)\n",
    "    return r.status_code == 200\n",
    "\n",
    "if TUNNEL_URL:\n",
    "    ok = update_gist(TUNNEL_URL, 'online')\n",
    "    print(f'Gist: {ok}')\n",
    "    print(f'API: POST {TUNNEL_URL}/prompt')\n",
    "else:\n",
    "    print('No URL yet')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## 5. Keep Alive"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f'Backend: {BACKEND_NAME}')\n",
    "print(f'Tunnel: {TUNNEL_URL}')\n",
    "try:\n",
    "    while True:\n",
    "        time.sleep(300)\n",
    "        if TUNNEL_URL:\n",
    "            update_gist(TUNNEL_URL, 'online')\n",
    "        print(f'[heartbeat] {datetime.now().isoformat()}')\n",
    "except KeyboardInterrupt:\n",
    "    if TUNNEL_URL:\n",
    "        update_gist(TUNNEL_URL, 'offline')\n",
    "    print('Stopped')"
   ]
  }
